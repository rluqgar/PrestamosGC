<Window x:Class="PrestamosGC.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préstamo de portátiles · Dpto. de Informática"
        Width="760" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <!-- cinco filas: cabecera, filtros, lista, botones y barra de estado. La de la lista es * para que sea la que crece -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,8">
            <Image Source="/Recursos/portatil.png" Height="48" Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Style="{StaticResource Titulo}" Text="Préstamos de portátiles"/>
                <TextBlock Style="{StaticResource Subtitulo}" Text="Departamento de Informática · IES Gran Capitán"/>
            </StackPanel>
        </StackPanel>

        <!-- filtros -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
            <!-- margen para los RadioButton de este panel -->
            <StackPanel.Resources>
                <Style TargetType="RadioButton">
                    <Setter Property="Margin" Value="12,0,0,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="Mostrar:" VerticalAlignment="Center"/>
            <!-- los cuatro tienen el mismo GroupName y el mismo Filtro_Checked -->
            <RadioButton x:Name="rbTodos" Content="Todos" GroupName="Filtro"
                         IsChecked="True" Checked="Filtro_Checked"/>
            <RadioButton x:Name="rbActivos" Content="En préstamo" GroupName="Filtro"
                         Checked="Filtro_Checked"/>
            <RadioButton x:Name="rbVencidos" Content="Vencidos" GroupName="Filtro"
                         Checked="Filtro_Checked"/>
            <RadioButton x:Name="rbDevueltos" Content="Devueltos" GroupName="Filtro"
                         Checked="Filtro_Checked"/>
        </StackPanel>

        <!-- lista -->
        <ListBox Grid.Row="2" x:Name="lstPrestamos"
                 Margin="16,0,16,8"
                 DisplayMemberPath="Resumen"
                 SelectionMode="Single"
                 SelectionChanged="lstPrestamos_SelectionChanged"
                 MouseDoubleClick="lstPrestamos_MouseDoubleClick"/>

        <!-- botones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,0,16,12">
            <Button x:Name="btnDetalle" Content="Ver detalle"
                    Style="{StaticResource BotonSecundario}"
                    IsEnabled="False" Click="btnDetalle_Click"/>
            <Button x:Name="btnNuevo" Content="Nuevo préstamo"
                    Style="{StaticResource BotonPrincipal}"
                    Click="btnNuevo_Click"/>
        </StackPanel>

        <!-- barra de estado -->
        <Border Grid.Row="4" Background="{StaticResource ColorFondoBarra}"
                BorderBrush="{StaticResource ColorBorde}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock x:Name="txtEstado"
                       Foreground="{StaticResource ColorTextoSecundario}"/>
        </Border>
    </Grid>
</Window>
