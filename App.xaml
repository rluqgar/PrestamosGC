<Application x:Class="PrestamosGC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="VentanaPrincipal.xaml">
    <Application.Resources>

        <!-- colores (los tres últimos los he añadido yo para no poner colores sueltos en las ventanas) -->
        <SolidColorBrush x:Key="ColorPrincipal" Color="#0F6CBD"/>
        <SolidColorBrush x:Key="ColorError" Color="#C42B1C"/>
        <SolidColorBrush x:Key="ColorCorrecto" Color="#0F7B0F"/>
        <SolidColorBrush x:Key="ColorTextoSecundario" Color="#5F5F5F"/>
        <SolidColorBrush x:Key="ColorFondoTarjeta" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorTextoClaro" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorFondoBarra" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#D0D0D0"/>

        <!-- estilos de texto -->
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- el mensaje de error empieza oculto y lo mostramos desde el código -->
        <Style x:Key="MensajeError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorError}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- estos tres no tienen clave, así se aplican a todos los TextBox, ComboBox y DatePicker -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- botones -->
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- el botón azul parte del normal. Le hago plantilla propia para que al pasar el ratón no cambie de color -->
        <Style x:Key="BotonPrincipal" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
            <Setter Property="Background" Value="{StaticResource ColorPrincipal}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoClaro}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- estilos de la ventana de detalle -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorFondoTarjeta}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,16,0,16"/>
        </Style>

        <!-- el círculo azul con el código del portátil -->
        <Style x:Key="Insignia" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorPrincipal}"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
        </Style>

        <Style x:Key="EtiquetaDetalle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
            <Setter Property="Margin" Value="0,6,16,6"/>
        </Style>

        <Style x:Key="ValorDetalle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </Application.Resources>
</Application>
